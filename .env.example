# Railway Postgres connection string
# Railway → your Postgres service → "Connect" tab → copy the connection URL
DATABASE_URL="postgresql://user:password@host:port/database"

# Fallback Printful API key, used by any store that doesn't set its own
# Store.printfulApiKey (Settings → API in your Printful account).
PRINTFUL_API_KEY=""

# Global session-signing secret for the human /admin login (every store has
# its own password, but sessions are all signed with this one secret).
ADMIN_SESSION_SECRET="a-long-random-string"

# Platform-wide bearer token for POST /api/platform/stores — the endpoint
# that creates new stores. Not tied to any single store. Generate with:
# openssl rand -hex 32. See docs/AGENT_API.md.
PLATFORM_API_KEY=""

# Multi-tenancy: the root domain stores are subdomains of in production,
# e.g. "yourdomain.com" so "first-available.yourdomain.com" resolves to
# the store with slug "first-available". Leave unset in local dev.
ROOT_DOMAIN=""

# Local dev only: which store to serve when there's no subdomain to read
# (e.g. localhost:3000). Must match a seeded Store.slug. Overridden by a
# ?store=<slug> query param on any request.
DEV_STORE_SLUG="wildline"
