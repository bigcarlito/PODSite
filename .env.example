# Railway Postgres connection string
# Railway → your Postgres service → "Connect" tab → copy the connection URL
DATABASE_URL="postgresql://user:password@host:port/database"

# Printful API key (Settings → API in your Printful account)
PRINTFUL_API_KEY=""

# Admin dashboard (/admin) login — for a human in a browser
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="a-long-random-string"

# Agent API (/api/agent/*) bearer token — for an AI agent or script.
# Generate with: openssl rand -hex 32
# See docs/AGENT_API.md for the full reference.
ADMIN_API_KEY=""
