generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FulfillmentProviderName {
  PRINTFUL
  PRINTIFY
  GELATO
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SUBMITTED_TO_FULFILLMENT
  IN_PRODUCTION
  SHIPPED
  CANCELED
}

/// A single storefront/tenant. One app + one database serves every store;
/// everything else (Product, Collection, Cart, Order) belongs to exactly
/// one Store. See AGENTS.md for why: an agent creating a store is a row
/// insert + agent-API calls, not new infrastructure. Never add columns
/// here for a single store's one-off need — theme/nav/footer/etc. are
/// JSON precisely so brand-specific shape doesn't require a migration.
model Store {
  id          String  @id @default(cuid())
  /// Subdomain label — first-available.yourdomain.com
  slug        String  @unique
  /// Optional custom domain, checked before slug when resolving a request.
  domain      String? @unique
  isActive    Boolean @default(true)

  name        String
  tagline     String
  description String
  /// Free-text brand tone brief, e.g. "self-deprecating, insider humor" —
  /// meant to be read by an agent generating copy/products for this store,
  /// not rendered on the storefront itself.
  tone        String?
  /// Free-text target audience brief, e.g. "casual/intermediate disc golfers".
  audience    String?
  /// Fuller brand/business knowledge for an agent to read before acting —
  /// mission, differentiators, pricing philosophy/margin targets, voice
  /// examples, things to avoid. Free-form JSON on purpose (see AGENTS.md
  /// #10): shape varies by store and grows over time without a migration.
  /// e.g. { "mission": "...", "pricingPhilosophy": "...",
  ///        "voiceExamples": ["..."], "avoid": ["..."] }
  brief       Json    @default("{}")

  /// { "accent": "#...", "accentDark": "#...", "logoUrl": "...",
  ///   "heroImageUrl": "..." }
  theme       Json @default("{}")
  /// [{ "label": "...", "href": "..." }, ...]
  nav         Json @default("[]")
  /// { "Help": [{ "label": "...", "href": "..." }], "Company": [...] }
  footerLinks Json @default("{}")
  /// ["25,000+ happy customers", ...]
  trustBadges Json @default("[]")
  /// [{ "label": "Instagram", "href": "..." }, ...]
  socialLinks Json @default("[]")
  /// Optional announcement banner shown above the header on every page —
  /// null/empty means no banner. Raw HTML, rendered unescaped: this is
  /// trusted content set by the store's own admin/agent (never end-user
  /// input), same trust level as theme/nav/footerLinks.
  bannerHtml  String?

  /// scrypt hash ("salt:hash" hex) of this store's human /admin password.
  /// Never store or compare the plaintext password.
  adminPasswordHash String
  /// sha256 hex hash of this store's agent-API bearer token. The plaintext
  /// key is generated once at store-creation time and returned only then.
  agentApiKeyHash   String
  /// This store's own Printful account key, if different from the
  /// platform default. Falls back to PRINTFUL_API_KEY when unset.
  printfulApiKey    String?

  products    Product[]
  variants    ProductVariant[]
  collections Collection[]
  carts       Cart[]
  orders      Order[]
  activity    ActivityLogEntry[]
  assets      StoreAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// An uploaded binary asset (currently just the homepage hero image) owned
/// by a store. Kept in its own table — never inline on Store — so that
/// getCurrentStore() (called on every request) never pulls image bytes off
/// disk; only GET /api/assets/[id] reads `data`. Storing bytes in Postgres
/// rather than requiring S3/Cloudinary credentials keeps store creation a
/// data insert (see AGENTS.md "north star") — no bucket to provision, no
/// extra credentials for a store/agent to manage.
model StoreAsset {
  id       String @id @default(cuid())
  storeId  String
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// What this asset is used for, e.g. "hero-image". Free text on purpose —
  /// a new asset kind is a data change, not a migration (see AGENTS.md #10).
  kind     String
  data     Bytes
  mimeType String

  createdAt DateTime @default(now())

  @@index([storeId, kind])
}

/// A running history of what changed and why, per store — the "recent
/// activity" half of full agent context (the other half is Store.brief +
/// GET /api/agent/summary). Without this, every fresh agent session
/// re-discovers the business from scratch and can repeat failed
/// experiments. Written automatically by key mutations (price/stock
/// changes, order status changes, brand updates) and by agents/humans
/// leaving explicit notes via POST /api/agent/activity. Never edited or
/// deleted — it's a log, not a mutable record.
model ActivityLogEntry {
  id        String   @id @default(cuid())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId   String
  /// Who/what recorded this: "agent", "admin" (human /admin action),
  /// "customer" (e.g. an order placed), or "system".
  actor     String
  /// Free-text category for filtering, e.g. "product", "pricing",
  /// "order", "fulfillment", "brand", "note". Not an enum on purpose —
  /// new categories shouldn't need a migration.
  category  String
  summary   String
  /// Optional structured detail, e.g. { "productId": "...", "from": 2995, "to": 2495 }
  details   Json?
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

model Collection {
  id          String              @id @default(cuid())
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId     String
  slug        String
  title       String
  description String?
  heroImage   String?
  products    ProductCollection[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([storeId, slug])
}

model Product {
  id          String              @id @default(cuid())
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId     String
  slug        String
  title       String
  description String
  /// Ordered variant option keys for this product, e.g. ["size","color"]
  /// for apparel or ["printType","size"] for wall art. Drives which
  /// selectors the product page renders and what keys each variant's
  /// `options` should have. Generic on purpose — see AGENTS.md.
  optionNames String[]
  images      ProductImage[]
  variants    ProductVariant[]
  collections ProductCollection[]
  isFeatured  Boolean             @default(false)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([storeId, slug])
}

model ProductCollection {
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String

  @@id([productId, collectionId])
}

model ProductImage {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  altText   String?
  position  Int      @default(0)
}

model ProductVariant {
  id                String                  @id @default(cuid())
  store             Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId           String
  product           Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId         String
  sku               String
  /// Option values for this variant, keyed by the product's optionNames,
  /// e.g. {"size":"M","color":"Forest"} or {"printType":"Canvas","size":"16x20"}.
  /// Every variant of a product should have a value for every optionName.
  options           Json                    @default("{}")
  priceCents        Int
  currency          String                  @default("USD")
  provider          FulfillmentProviderName @default(PRINTFUL)
  providerVariantId String?
  inStock           Boolean                 @default(true)
  cartItems         CartItem[]
  orderItems        OrderItem[]
  quotes            ProviderQuote[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([storeId, sku])
}

model ProviderQuote {
  id            String                  @id @default(cuid())
  variant       ProductVariant          @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId     String
  provider      FulfillmentProviderName
  costCents     Int
  shippingCents Int
  currency      String                  @default("USD")
  fetchedAt     DateTime                @default(now())

  @@unique([variantId, provider])
}

model Cart {
  id        String     @id @default(cuid())
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId   String
  token     String     @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  variantId String
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
}

model Order {
  id               String      @id @default(cuid())
  store            Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId          String
  orderNumber      String
  email            String
  shippingName     String
  shippingAddress1 String
  shippingAddress2 String?
  shippingCity     String
  shippingState    String
  shippingZip      String
  shippingCountry  String
  status           OrderStatus @default(PENDING_PAYMENT)
  items            OrderItem[]
  subtotalCents    Int
  providerOrderId  String?
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([storeId, orderNumber])
}

model OrderItem {
  id          String         @id @default(cuid())
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  variantId   String
  quantity    Int
  priceCents  Int
  productName String
  variantName String
}
